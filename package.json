  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhubbard/apfel-rs.git"
  },
  "keywords": [
    "apple-intelligence",
    "foundation-models",
    "llm",
    "openai",
    "mcp",
    "cli"
  ],
  "author": "Brandon Hubbard",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bhubbard/apfel-rs/issues"
  },
